<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app hide other apps' floating windows over its own screens. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Optional call notifications (Settings). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Fingerprint lock (Settings). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- allowBackup=false keeps the encrypted settings off cloud backups. -->
    <application
        android:name=".AgentControlApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/no_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AgentControl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:label="@string/settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CallDetailActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.AgentControl.WithBar" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AgentControl.WithBar" />

        <activity
            android:name=".ContactsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.AgentControl.WithBar" />

        <!-- Optional: watches for calls starting/ending to show notifications. -->
        <service
            android:name=".CallWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Notifies the user when their own AI phone agents start or end a call." />
        </service>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/widget_pick_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Not exported: only the system and this app's own widget taps can reach it. -->
        <receiver
            android:name=".EndCallWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/end_call_widget_info" />
        </receiver>
    </application>
</manifest>
