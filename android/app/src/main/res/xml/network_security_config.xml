<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificates from Android's built-in authorities.
     Certificates a user or app installs on the phone are not trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
